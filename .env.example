# =============================================================================
# POLICE CAD API - ENVIRONMENT VARIABLES
# =============================================================================
# Copy this file to .env and update with your actual values
# cp env.example.comprehensive .env

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# MongoDB connection URI (local or cloud)
export DB_URI=mongodb://localhost/knoldus
export DB_NAME=knoldus

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================
export PORT=8082
export BASE_URL=localhost
export ENV=local
export LOG_LEVEL=debug

# =============================================================================
# JWT AUTHENTICATION
# =============================================================================
# 256-bit secret key for JWT token generation/validation
# Generate using: https://passwordsgenerator.net/ (256 chars, all options enabled)
# Example: sRqXKbHFdQ8Wka6NWvk3ZaZhY3JD3CnUw7H5B42gETZS8feYUFUJ8k2jRvnNQrLwEyPWnwfuGN9XG3GQaPxC6HdtNNYmbZW6M
export SECRET_KEY='your-256-bit-secret'

# =============================================================================
# STRIPE PAYMENT PROCESSING
# =============================================================================
# Stripe API keys (get from https://dashboard.stripe.com/apikeys)
export STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
export WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Stripe Price IDs for different subscription tiers (V1 — kept for webhook reverse-mapping)
export STRIPE_BASE_MONTHLY_PRICE_ID=price_your_base_monthly_price_id
export STRIPE_BASE_ANNUAL_PRICE_ID=price_your_base_annual_price_id
export STRIPE_PREMIUM_MONTHLY_PRICE_ID=price_your_premium_monthly_price_id
export STRIPE_PREMIUM_ANNUAL_PRICE_ID=price_your_premium_annual_price_id
export STRIPE_PREMIUM_PLUS_MONTHLY_PRICE_ID=price_your_premium_plus_monthly_price_id
export STRIPE_PREMIUM_PLUS_ANNUAL_PRICE_ID=price_your_premium_plus_annual_price_id

# Stripe Price IDs V2 (post-price-drop). Empty = fall back to V1 prices for new checkouts.
export STRIPE_BASE_V2_MONTHLY_PRICE_ID=
export STRIPE_BASE_V2_ANNUAL_PRICE_ID=
export STRIPE_PREMIUM_V2_MONTHLY_PRICE_ID=
export STRIPE_PREMIUM_V2_ANNUAL_PRICE_ID=
export STRIPE_PREMIUM_PLUS_V2_MONTHLY_PRICE_ID=
export STRIPE_PREMIUM_PLUS_V2_ANNUAL_PRICE_ID=

# When true, /api/v1/subscription/tiers returns the post-drop V2 prices with
# onSale=true so web and mobile clients render the SALE badge + strikethrough.
# Flip this last (after Stripe products + Heroku V2 env vars are populated).
export KICKBACK_PRICE_DROP_LIVE=false

# Stripe Promotion Price IDs
export STRIPE_BASIC_PROMOTION_MONTHLY_PRICE_ID=price_your_basic_promotion_monthly_price_id
export STRIPE_STANDARD_PROMOTION_MONTHLY_PRICE_ID=price_your_standard_promotion_monthly_price_id
export STRIPE_PREMIUM_PROMOTION_MONTHLY_PRICE_ID=price_your_premium_promotion_monthly_price_id
export STRIPE_ELITE_PROMOTION_MONTHLY_PRICE_ID=price_your_elite_promotion_monthly_price_id

# =============================================================================
# EMAIL SERVICES (SENDGRID)
# =============================================================================
# SendGrid API key for email notifications
# Get from: https://app.sendgrid.com/settings/api_keys
export SENDGRID_API_KEY=SG.your_sendgrid_api_key_here

# =============================================================================
# CLOUDINARY FILE UPLOAD
# =============================================================================
# Cloudinary credentials for file uploads
# Get from: https://cloudinary.com/console
export CLOUDINARY_UPLOAD_PRESET=your_upload_preset_name
export CLOUDINARY_API_SECRET=your_cloudinary_api_secret_here

# =============================================================================
# DEVELOPMENT & TESTING
# =============================================================================
# URL mode for testing (set to "testing" for local development)
export URL_MODE=testing

# =============================================================================
# DISCORD BOT HEALTH MONITORING
# =============================================================================
# Shared secret the Discord bot sends in the X-Bot-Heartbeat-Token header on
# POST /health/discord-bot/heartbeat. It MUST match the bot's own
# BOT_HEARTBEAT_TOKEN. While this is unset the heartbeat endpoint returns 503
# and records nothing: the endpoint fails closed rather than accepting an
# unauthenticated claim that the bot is healthy.
export BOT_HEARTBEAT_TOKEN=

# Discord webhook for the staff alerts-website channel. The bot-down and
# bot-recovered alerts post here. Unset means no alerts are posted.
export DISCORD_ALERTS_WEBSITE_WEBHOOK_URL=

# =============================================================================
# STATUS PAGE (UPPTIME)
# =============================================================================
# GitHub token the scheduler uses to run the status repo's workflows itself.
# The repo asks GitHub for a check every 5 minutes, but GitHub throttles
# scheduled workflows on a quiet repo down to a few runs a day, which is why
# the status page lagged hours behind the alerts channel. With this set, the
# API dispatches the check every 5 minutes and rebuilds the page when a check
# actually changed something.
#
# A fine-grained personal access token, scoped to Linesmerrill/police-cad-status
# alone, with Actions: read and write. Nothing else. Unset means the job does
# not register at all, which is what local dev and preview apps want: the
# status repo keeps its own daily schedules as the backstop.
export STATUS_DISPATCH_TOKEN=

# Overrides, both optional. Defaults are Linesmerrill/police-cad-status and
# master. Point them at a fork to try changes without touching the real page.
export STATUS_DISPATCH_REPO=
export STATUS_DISPATCH_REF=

# =============================================================================
# OPTIONAL CONFIGURATIONS
# =============================================================================
# Add any additional environment variables here as needed

# =============================================================================
# DEPLOYMENT NOTES
# =============================================================================
# For production deployment:
# 1. Set ENV=production
# 2. Use production MongoDB URI
# 3. Use production Stripe keys (sk_live_...)
# 4. Set proper BASE_URL for your domain
# 5. Ensure all secrets are properly secured 